# ---------------------------------------------------------------------------
# SchulKompass NRW - environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL. Use an EU region (e.g. Frankfurt / eu-central-1) - see
# docs/PRIVACY.md. Pooled connections: append ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://user:password@localhost:5432/schulkompass?schema=public"

# Auth.js v5. Generate with: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=""
# Public origin of the deployment, used to build magic-link callback URLs.
AUTH_URL="http://localhost:3000"

# Canonical public origin used for canonical tags, hreflang alternates, the
# sitemap and the structured data on school pages. Falls back to AUTH_URL.
# Getting this wrong publishes a sitemap full of unreachable URLs, so the app
# warns at runtime if it is unset or points at localhost in production.
SITE_URL="http://localhost:3000"

# Comma-separated list of email domains allowed to request an admin magic link.
# A matching domain is necessary but not sufficient - the address must also be
# pre-provisioned in the User table (invite only).
ALLOWED_ADMIN_EMAIL_DOMAINS="duesseldorf.de,nrw.schule,schule.nrw.de"

# SMTP for magic-link delivery. Use an EU-hosted mail provider.
EMAIL_FROM="SchulKompass NRW <noreply@schulkompass.nrw>"
EMAIL_SERVER_HOST="smtp.example.org"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Development convenience: print the magic link to the server console instead of
# requiring a working SMTP server. MUST stay unset/false in production.
AUTH_DEV_LOG_MAGIC_LINK="false"

# Optional: override the open-data source used by `prisma/seed.ts`.
# SEED_SCHOOLS_URL=""
